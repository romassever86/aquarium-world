<%- include('partials/header') %>

<h1>Contact us</h1>
<p>Questions about your visit? Send us a message and our team will get back to you.</p>

<% if (submitted) { %>
  <p class="success-message" role="status">Thank you &mdash; your message has been sent!</p>
<% } %>

<% if (errors) { %>
  <div class="form-errors" role="alert">
    <ul>
      <% errors.forEach(error => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form id="contact-form" action="/contact" method="POST" novalidate>
  <fieldset>
    <legend>Send us a message</legend>

    <div class="form-field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required>
    </div>

    <div class="form-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" aria-describedby="email-hint" required>
      <p id="email-hint">We'll only use this to reply to your message.</p>
    </div>

    <div class="form-field">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" required></textarea>
    </div>
  </fieldset>

  <button type="submit">Send Message</button>
</form>

<script src="/js/main.js"></script>

<%- include('partials/footer') %>
