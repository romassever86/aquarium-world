<%- include('partials/header') %>

<h1>Welcome to Aquarium World</h1>
<p>Open every day, 9am to 6pm.</p>

<h2>Our Zones</h2>
<% zones.forEach(zone => { %>
  <article>
    <h3><%= zone.name %></h3>
    <p><%= zone.description %></p>
    <a href="/zones/<%= zone.slug %>">Visit this zone</a>
  </article>
<% }) %>

<%- include('partials/footer') %>