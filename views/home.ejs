<%- include('partials/header') %>

<h1>Welcome to Aquarium World</h1>
<p>Open every day, 9am to 6pm.</p>

<section class="search-section" aria-label="Search exhibits">
  <label for="search-input">Search our exhibits</label>
  <input type="text" id="search-input" placeholder="Try 'coral' or 'shark'..." autocomplete="off">
  <ul id="search-results" aria-live="polite"></ul>
</section>

<section class="spotlight-section" aria-label="Exhibit spotlight">
  <h2>Exhibit spotlight</h2>
  <p>Not sure where to start? Let us pick one for you.</p>
  <button type="button" id="spotlight-button">Show me an exhibit</button>
  <div id="spotlight-result" aria-live="polite"></div>
</section>

<h2>Our Zones</h2>
<% zones.forEach(zone => { %>
  <article>
    <img src="<%= zone.image %>" alt="<%= zone.name %>">
    <h3><%= zone.name %></h3>
    <p><%= zone.description %></p>
    <a href="/zones/<%= zone.slug %>">Visit this zone</a>
  </article>
<% }) %>

<script src="/js/search.js"></script>
<script src="/js/spotlight.js"></script>

<%- include('partials/footer') %>
